# DeepSeek AI — powers strategic analysis, cost estimation, and the AI chat
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ClickUp — for syncing discovery summaries to your project management tool
VITE_CLICKUP_API_KEY=your_clickup_api_key_here
VITE_CLICKUP_LIST_ID=your_clickup_list_id_here

# Resend — for sending the discovery summary as a real email (send-summary-email function)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@yourdomain.com
AGENCY_TEAM_EMAIL=team@youragency.com

# Gemini (free tier) — if set, the AI features use Gemini instead of DeepSeek
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (default: gemini-2.5-flash, or deepseek-chat)
LLM_MODEL=
